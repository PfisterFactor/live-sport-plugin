# Port the addon server will listen on
PORT=7000

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: latency budgets (milliseconds)
# Per-provider budget during a catalog sync. A provider that exceeds it is
# skipped for that sync instead of holding up every other provider.
PROVIDER_SYNC_TIMEOUT_MS=8000
# Stream request budget. At the soft deadline the addon answers with whatever
# resolved, as long as there is at least one stream; the hard deadline always
# ends the wait. Sources that miss both keep minting into the resolve cache.
STREAM_SOFT_DEADLINE_MS=4500
STREAM_HARD_DEADLINE_MS=12000
