# Port the addon server will listen on
PORT=7000

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: latency budgets (milliseconds)
# Per-provider budget during a catalog sync. A provider that exceeds it is
# skipped for that sync instead of holding up every other provider. Every
# fetch the provider makes is clamped to this budget.
PROVIDER_SYNC_TIMEOUT_MS=8000
# LiveTV replay scrape budget (21 archive pages, refreshed every 12 hours).
LIVETV_SYNC_TIMEOUT_MS=60000
# Stream request budget. At the soft deadline the addon answers with whatever
# resolved, as long as there is at least one stream; the hard deadline always
# ends the wait. Sources that miss both keep minting into the resolve cache.
STREAM_SOFT_DEADLINE_MS=4500
STREAM_HARD_DEADLINE_MS=12000
# After the soft deadline the addon keeps waiting, up to STREAM_GRACE_MAX_MS,
# until this fraction of the sources has settled (0 disables the wait).
STREAM_GRACE_MAX_MS=7000
STREAM_QUORUM=0.6

# Optional: comma-separated hostnames the byte proxies may fetch from.
# Unset means any public host. Private and loopback addresses are always refused.
STREAM_PROXY_ALLOWED_HOSTS=

# Optional: ClearKey DASH relay (/api/dash). DASH_SIGN_SECRET (16+ chars) signs the
# playlist links; unset, a random key is generated per process and links die on
# restart. DASH_TOKEN_TTL is the link lifetime in seconds, DASH_MAX_CONCURRENT
# caps simultaneous segment fetch+decrypt jobs, DASH_SEGMENT_CACHE_MAX the
# decrypted segments kept in memory (about 2 MB each at 1080p).
DASH_SIGN_SECRET=
DASH_TOKEN_TTL=21600
DASH_MAX_CONCURRENT=24
DASH_SEGMENT_CACHE_MAX=96

# Optional: list the Vavoo 24/7 sports channels (impersonates the Vavoo app ping).
VAVOO_ENABLED=false
