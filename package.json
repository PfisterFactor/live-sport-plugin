{
  "name": "nuvio-live-sports-plugin",
  "version": "3.0.0",
  "description": "The ultimate live sports streaming add-on for Nuvio/Stremio. Scrapes multiple high-speed providers with a zero-lag proxy.",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch-path=src src/index.js",
    "build": "ncc build src/index.js -o dist --minify && copyfiles -f \"src/providers/*.wasm\" \"src/providers/*.js\" dist",
    "test:sanity": "node scripts/test-sanity-zero-cache.js",
    "test:e2e-client": "node scripts/test-e2e-simulated-client.js",
    "test:247": "node scripts/test-247-channels.js",
    "check-sources": "node scripts/check-sources.js"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "express": "^4.18.2",
    "impit": "0.14.4",
    "m3u8-parser": "^7.2.0",
    "stremio-addon-sdk": "^1.6.10",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "copyfiles": "^2.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addon",
    "live-sports",
    "sports-streaming"
  ],
  "license": "MIT"
}
