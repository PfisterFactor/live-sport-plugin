{
  "name": "nuvio-live-sports-plugin",
  "version": "3.0.0",
  "description": "The ultimate live sports streaming add-on for Nuvio/Stremio. Scrapes multiple high-speed providers with a zero-lag proxy.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js",
    "test": "bun test tests/unit",
    "test:sanity": "node scripts/test-sanity-zero-cache.js",
    "test:e2e-client": "node scripts/test-e2e-simulated-client.js",
    "test:247": "node scripts/test-247-channels.js",
    "check-sources": "node scripts/check-sources.js"
  },
  "dependencies": {
    "impit": "0.14.4",
    "undici": "8.10.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addon",
    "live-sports",
    "sports-streaming"
  ],
  "license": "MIT"
}
