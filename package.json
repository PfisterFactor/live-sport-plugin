{
  "name": "nuvio-live-sports-plugin",
  "version": "3.0.0",
  "description": "The ultimate live sports streaming add-on for Nuvio/Stremio. Scrapes multiple high-speed providers with a zero-lag proxy.",
  "main": "src/index.js",
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun --watch src/index.js",
    "test": "bun test tests/unit",
    "test:sanity": "bun scripts/test-sanity-zero-cache.js",
    "test:e2e-client": "bun scripts/test-e2e-simulated-client.js",
    "test:247": "bun scripts/test-247-channels.js",
    "check-sources": "bun scripts/check-sources.js"
  },
  "dependencies": {
    "impit": "0.14.4",
    "undici": "8.10.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addon",
    "live-sports",
    "sports-streaming"
